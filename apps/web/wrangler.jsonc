/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Derived from the official OpenNext Cloudflare Next.js template
 * (opennextjs/opennextjs-cloudflare create-cloudflare/next).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-formatting-tool",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "text-formatting-tool",
    },
  ],
  // Rate limiting: RecipeGenerationRateLimiter exists in application code with an
  // in-memory local/dev implementation. A Cloudflare Rate Limiting binding is not
  // wired or claimed active in this milestone. Add a validated binding later, e.g.:
  // "unsafe": { "bindings": [{ "name": "RECIPE_RATE_LIMITER", "type": "ratelimit", ... }] }
}
