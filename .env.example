# Environment example for Text Formatting Tool v2

# Recipe generator mode: prototype (default, local examples) or openai (server-side AI)
RECIPE_GENERATOR_MODE=prototype

# Server-only model name for OpenAI Responses API + Structured Outputs.
# Example tested target: gpt-5-mini (configurable; not every model will work).
# Never expose this through NEXT_PUBLIC_*.
OPENAI_MODEL=gpt-5-mini

# Server-only OpenAI API key. Leave empty locally until you intentionally enable openai mode.
# Never commit a real value. Never put a key in NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Local setup (founder):
# 1. Copy this file to apps/web/.env.local (gitignored) or the repo-root .env.local used by Next.
# 2. Set RECIPE_GENERATOR_MODE=openai
# 3. Set OPENAI_MODEL to a Responses API + Structured Outputs capable model
# 4. Set OPENAI_API_KEY to your secret
# 5. Restart: npm run dev
# Do not commit the local env file.
#
# Cloudflare production (later; do not deploy in this milestone):
#   wrangler secret put OPENAI_API_KEY
# Configure RECIPE_GENERATOR_MODE and OPENAI_MODEL as non-secret Worker vars.
